<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    android:layoutDirection="ltr"
    android:padding="25dp">

    <View
        android:id="@+id/mic_circle"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:background="@drawable/circle_outline"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/mic_icon"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:src="@drawable/microphone"
        android:contentDescription="Microphone Icon"
        app:layout_constraintTop_toTopOf="@id/mic_circle"
        app:layout_constraintBottom_toBottomOf="@id/mic_circle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/text_monitoring_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Monitoring is ACTIVE"
        android:textSize="20sp"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/mic_circle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_pause"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pause Monitoring"
        android:textColor="#FFFFFF"
        app:backgroundTint="#F44336"
        android:layout_marginTop="30dp"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        app:cornerRadius="16dp"
        app:layout_constraintTop_toBottomOf="@id/text_monitoring_status"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/text_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Monitoring runs automatically in the background"
        android:textColor="@color/black"
        android:textSize="14sp"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/button_pause"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/text_settings_summary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Every 10 min  •  08:00–18:00"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/text_info"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
