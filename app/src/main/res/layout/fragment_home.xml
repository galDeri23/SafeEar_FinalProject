<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:padding="32dp">

    <!-- עיגול רקע -->
    <View
        android:id="@+id/mic_circle"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:background="@drawable/circle_outline"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintTop_margin="48dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- אייקון מיקרופון -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/mic_icon"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/microphone"
        android:contentDescription="Microphone Icon"
        app:layout_constraintTop_toTopOf="@id/mic_circle"
        app:layout_constraintBottom_toBottomOf="@id/mic_circle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- סטטוס ניטור -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/text_monitoring_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Monitoring is ACTIVE"
        android:textSize="20sp"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/mic_circle"
        app:layout_constraintTop_margin="40dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- זמן האזנה -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/text_monitoring_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0h 00m"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#0D47A1"
        android:layout_margin="16dp"
        app:layout_constraintTop_toBottomOf="@id/text_monitoring_status"
        app:layout_constraintTop_margin="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- כפתור עצירה -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_pause"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pause Monitoring"
        android:textColor="#FFFFFF"
        app:backgroundTint="#F44336"
        android:layout_marginTop="30dp"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        app:cornerRadius="16dp"
        app:layout_constraintTop_toBottomOf="@id/text_monitoring_time"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />



    <!-- תקציר הגדרות -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/text_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Monitoring runs automatically in the background"
        android:textColor="@color/black"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_margin="32dp"
        app:layout_constraintTop_toBottomOf="@id/button_pause" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/text_settings_summary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Every 10 min  •  08:00–18:00"
        android:textColor="@color/black"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_margin="16dp"
        app:layout_constraintTop_toBottomOf="@id/text_info" />

</androidx.constraintlayout.widget.ConstraintLayout>
