<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.example.safeear_finalproject.ui.home.HomeFragment"
        android:label="@string/title_home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/navigation_setting"
        android:name="com.example.safeear_finalproject.ui.Settings.SettingsFragment"
        android:label="@string/title_Settings"
        tools:layout="@layout/fragment_settings" />

    <fragment
        android:id="@+id/navigation_report"
        android:name="com.example.safeear_finalproject.ui.Reports.ReportsFragment"
        android:label="@string/title_Reports"
        tools:layout="@layout/fragment_reports" />
</navigation>